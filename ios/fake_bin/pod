#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
if [ "${1:-}" = "install" ] && [ -f "Podfile.lock" ] && [ -f "Pods/Manifest.lock" ]; then
  if cmp -s "Podfile.lock" "Pods/Manifest.lock"; then
    echo "Pod install skipped: Podfile.lock matches Pods/Manifest.lock"
    exit 0
  fi
fi
exec /opt/homebrew/Cellar/cocoapods/1.16.2_2/libexec/bin/pod "$@"
