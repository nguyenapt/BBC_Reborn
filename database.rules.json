{
  "rules": {
    "ai_server_config": {
      ".read": false,
      ".write": false
    },
    "ai_cache": {
      ".read": true,
      ".write": true,
      "translations": {
        "$episodeId": {
          "$languageCode": {
            ".validate": "newData.hasChildren(['data', 'createdAt', 'version'])"
          }
        }
      },
      "grammar": {
        "$sentenceHash": {
          "$languageCode": {
            ".validate": "newData.hasChildren(['data', 'createdAt', 'version'])"
          }
        }
      },
      "questions": {
        "$episodeId": {
          "$count": {
            ".validate": "newData.hasChildren(['data', 'createdAt', 'version'])"
          }
        }
      },
      "vocabulary": {
        "$wordHash": {
          "$languageCode": {
            ".validate": "newData.hasChildren(['data', 'createdAt', 'version'])"
          }
        }
      },
      "access_stats": {
        "$episodeId": {
          ".validate": "newData.hasChildren(['episodeId', 'count', 'lastAccessed'])"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    ".read": true,
    ".write": "auth !== null"
  }
}
