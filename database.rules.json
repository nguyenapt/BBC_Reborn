{
  "rules": {
    "config": {
      "app_client_config": {
        ".read": true,
        ".write": false
      },
      "ai_server_config": {
        ".read": false,
        ".write": false
      }
    },
    "category": {
      ".read": true,
      ".write": "auth != null"
    },
    "ai_cache": {
      ".read": true,
      ".write": true,
      "translations": {
        "$episodeId": {
          "$languageCode": {
            ".validate": "newData.hasChildren(['data', 'createdAt', 'version'])"
          }
        }
      },
      "grammar": {
        "$sentenceHash": {
          "$languageCode": {
            ".validate": "newData.hasChildren(['data', 'createdAt', 'version'])"
          }
        }
      },
      "grammar_by_episode": {
        "$episodeId": {
          "$lineKey": {
            "$languageCode": {
              ".validate": "newData.hasChildren(['data', 'createdAt', 'version'])"
            }
          }
        }
      },
      "grammar_passage": {
        "$passageHash": {
          "$languageCode": {
            ".validate": "newData.hasChildren(['data', 'createdAt', 'version'])"
          }
        }
      },
      "questions": {
        "$episodeId": {
          "$count": {
            ".validate": "newData.hasChildren(['data', 'createdAt', 'version'])"
          }
        }
      },
      "vocabulary": {
        "$wordHash": {
          "$languageCode": {
            ".validate": "newData.hasChildren(['data', 'createdAt', 'version'])"
          }
        }
      },
      "vocabulary_by_episode": {
        "$episodeId": {
          "$itemKey": {
            ".validate": "newData.hasChildren(['data', 'createdAt', 'version'])"
          }
        }
      },
      "access_stats": {
        "$episodeId": {
          ".validate": "newData.hasChildren(['episodeId', 'count', 'lastAccessed'])"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    ".read": true,
    ".write": "auth != null"
  }
}
